  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnimacionDiagolo
  textoNombre: {fileID: 1925028099}
  textoDialogoEfecto: {fileID: 363505698}
  botonAvanzar: {fileID: 367099405}
  animatorRex: {fileID: 1154179972}
  sistemaNavegacion: {fileID: 1368078481}
  lineasDialogo:
  - "\xBFHola? \xBFHay alguien ah\xED?"
  - "\xA1Woah!"
  - "Creo que he bajado un poco de peso \xA1estoy en los huesos!"
  - Y ni hablar de que solo soy una cabeza...
  - Dejemos eso por ahora, seguro que luego hallaremos el resto de mi cuerpo. Ehrm...
  - "\xA1Saludos, paleont\xF3logo en proceso! Mis amigos y yo requerimos tu ayuda."
  - "Hace mucho tiempo intentamos digitalizarnos para evitar la extinci\xF3n."
  - "Pero parece que algunos c\xF3digos... gen\xE9ticos, se perdieron por el camino."
  - "Si nos ayudas a encontrar los c\xF3digos y a ordenarlos de la forma correcta..."
  - "\xA1Digitalizar\xEDamos a mis amigos! eso es \xBFPor qu\xE9 no empezamos de
    una vez?"
  - "\xBFPodr\xEDas ayudarme a encontrar el c\xF3digo de mi amigo Carnotauro? Apuesto
    a que se encuentra por aqu\xED."
  triggersAnimacion:
  - Craneo Habla
  - "Expresi\xF3n sorprendido"
  - Habla confundido
  - Craneo Habla
  - Craneo Habla
  - Craneo Habla
  - Craneo Habla
  - Craneo Habla
  - Craneo Habla
  - Craneo Habla
  - Craneo Habla
